{
  "trailingSlash": "auto",
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/api/*", "/assets/*", "*.{css,js,png,svg,ico,webmanifest}"]
  },
  "routes": [
    { "route": "/api/health", "allowedRoles": ["anonymous"] },
    { "route": "/api/*", "allowedRoles": ["authenticated"] },
    { "route": "/login", "rewrite": "/.auth/login/aad" },
    { "route": "/logout", "rewrite": "/.auth/logout" }
  ],
  "responseOverrides": {
    "401": { "statusCode": 401, "rewrite": "/index.html" }
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Content-Security-Policy": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self'"
  },
  "platform": {
    "apiRuntime": "node:20"
  }
}
